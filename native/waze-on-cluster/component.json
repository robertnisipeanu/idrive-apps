{
  "id": "waze-on-cluster",
  "kind": "tool",
  "version": "0.10.0",
  "license": "GPL-3.0-or-later",
  "title": "Waze on cluster",
  "description": "Runs the Waze on cluster map in the background. It is installed with the Waze on cluster app, which you use to control it.",
  "requires": {
    "mgu-deploy": "0.7.17",
    "cluster-render": "0.5.3"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "activate": [
    "node",
    "patchd.js",
    "activate"
  ],
  "deactivate": [
    "node",
    "patchd.js",
    "deactivate"
  ],
  "build": [
    "make",
    "target"
  ],
  "files": [
    {
      "path": "waze-on-cluster",
      "from": "build/target/waze-on-cluster",
      "mode": "0755"
    },
    {
      "path": "waze-on-cluster.conf",
      "from": "waze-on-cluster.conf",
      "mode": "0644"
    },
    {
      "path": "carplay_patch.js",
      "from": "patch/carplay_patch.js",
      "mode": "0644"
    },
    {
      "path": "carplay_locate.js",
      "from": "patch/carplay_locate.js",
      "mode": "0644"
    },
    {
      "path": "aapd_patch.js",
      "from": "patch/aapd_patch.js",
      "mode": "0644"
    },
    {
      "path": "aapd_locate.js",
      "from": "patch/aapd_locate.js",
      "mode": "0644"
    },
    {
      "path": "x86_flow.js",
      "from": "patch/x86_flow.js",
      "mode": "0644"
    },
    {
      "path": "aapd_conf.js",
      "from": "patch/aapd_conf.js",
      "mode": "0644"
    },
    {
      "path": "patchd.js",
      "from": "patch/patchd.js",
      "mode": "0644"
    },
    {
      "path": "recovery.js",
      "from": "patch/recovery.js",
      "mode": "0644"
    },
    {
      "path": "patch_record.js",
      "from": "patch/patch_record.js",
      "mode": "0644"
    },
    {
      "path": "file_mode.js",
      "from": "patch/file_mode.js",
      "mode": "0644"
    },
    {
      "path": "remount_lock.js",
      "from": "patch/remount_lock.js",
      "mode": "0644"
    },
    {
      "path": "recmgr_list.js",
      "from": "patch/recmgr_list.js",
      "mode": "0644"
    },
    {
      "path": "head_unit.js",
      "from": "patch/head_unit.js",
      "mode": "0644"
    },
    {
      "path": "boot_id.js",
      "from": "patch/boot_id.js",
      "mode": "0644"
    },
    {
      "path": "shutdown_mark.sh",
      "from": "patch/shutdown_mark.sh",
      "mode": "0755"
    },
    {
      "path": "woc-patch.sh",
      "from": "patch/woc-patch.sh",
      "mode": "0755"
    },
    {
      "path": "dlt_capture.js",
      "from": "patch/dlt_capture.js",
      "mode": "0644"
    },
    {
      "path": "journal_keep.js",
      "from": "patch/journal_keep.js",
      "mode": "0644"
    },
    {
      "path": "logs.js",
      "from": "patch/logs.js",
      "mode": "0644"
    },
    {
      "path": "logs_fw.js",
      "from": "patch/logs_fw.js",
      "mode": "0644"
    },
    {
      "path": "logs_extra.js",
      "from": "patch/logs_extra.js",
      "mode": "0644"
    },
    {
      "path": "wifi_band.js",
      "from": "patch/wifi_band.js",
      "mode": "0644"
    },
    {
      "path": "group_dir.js",
      "from": "patch/group_dir.js",
      "mode": "0644"
    },
    {
      "path": "collect-logs.sh",
      "from": "tools/collect-logs.sh",
      "mode": "0755"
    },
    {
      "path": "LICENSE",
      "from": "LICENSE",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "waze-on-cluster.socket",
      "from": "systemd/waze-on-cluster.socket"
    },
    {
      "name": "waze-on-cluster.service",
      "from": "systemd/waze-on-cluster.service"
    },
    {
      "name": "waze-on-cluster-patchd.service",
      "from": "systemd/waze-on-cluster-patchd.service"
    },
    {
      "name": "waze-on-cluster-boot.service",
      "from": "systemd/waze-on-cluster-boot.service",
      "runsInSafeMode": true
    },
    {
      "name": "waze-on-cluster-aa-boot.service",
      "from": "systemd/waze-on-cluster-aa-boot.service",
      "runsInSafeMode": true
    },
    {
      "name": "waze-on-cluster-recovery.service",
      "from": "systemd/waze-on-cluster-recovery.service",
      "runsInSafeMode": true
    },
    {
      "name": "waze-on-cluster-capture.service",
      "from": "systemd/waze-on-cluster-capture.service"
    },
    {
      "name": "waze-on-cluster-journal.service",
      "from": "systemd/waze-on-cluster-journal.service"
    },
    {
      "name": "waze-on-cluster-journal.timer",
      "from": "systemd/waze-on-cluster-journal.timer"
    },
    {
      "name": "waze-on-cluster-logs.socket",
      "from": "systemd/waze-on-cluster-logs.socket"
    },
    {
      "name": "waze-on-cluster-logs.service",
      "from": "systemd/waze-on-cluster-logs.service"
    },
    {
      "name": "waze-on-cluster-logs-fw.service",
      "from": "systemd/waze-on-cluster-logs-fw.service"
    }
  ],
  "enable": [
    {
      "unit": "waze-on-cluster.socket",
      "target": "sockets.target"
    },
    {
      "unit": "waze-on-cluster.service",
      "target": "multi-user.target"
    },
    {
      "unit": "waze-on-cluster-patchd.service",
      "target": "multi-user.target"
    },
    {
      "unit": "waze-on-cluster-boot.service",
      "target": "multi-user.target"
    },
    {
      "unit": "waze-on-cluster-aa-boot.service",
      "target": "multi-user.target"
    },
    {
      "unit": "waze-on-cluster-recovery.service",
      "target": "multi-user.target"
    },
    {
      "unit": "waze-on-cluster-capture.service",
      "target": "multi-user.target"
    },
    {
      "unit": "waze-on-cluster-journal.timer",
      "target": "timers.target"
    },
    {
      "unit": "waze-on-cluster-logs.socket",
      "target": "sockets.target"
    }
  ],
  "dropins": [
    {
      "unit": "var-opt-ro.service",
      "name": "50-waze-on-cluster.conf",
      "from": "systemd/var-opt-ro.service.d/50-waze-on-cluster.conf"
    },
    {
      "unit": "carplay.service",
      "name": "50-waze-on-cluster.conf",
      "from": "systemd/carplay.service.d/50-waze-on-cluster.conf"
    }
  ],
  "recmgr": [
    "carplay",
    "aapd",
    "waze-on-cluster",
    "waze-on-cluster-patchd",
    "waze-on-cluster-boot",
    "waze-on-cluster-aa-boot",
    "waze-on-cluster-recovery",
    "waze-on-cluster-capture",
    "waze-on-cluster-journal",
    "waze-on-cluster-logs",
    "waze-on-cluster-logs-fw"
  ],
  "crashNames": [
    "aapd"
  ],
  "restart": [
    "waze-on-cluster.service",
    "waze-on-cluster-patchd.service",
    "waze-on-cluster-recovery.service",
    "waze-on-cluster-capture.service",
    "waze-on-cluster-journal.service"
  ]
}
