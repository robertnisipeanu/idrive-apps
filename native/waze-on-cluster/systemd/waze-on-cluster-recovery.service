[Unit]
Description=waze-on-cluster boot recovery: watch carplay and restore the original if the map patch makes it crash
RequiresMountsFor=/var/opt
After=local-fs.target waze-on-cluster-boot.service

[Service]
# Root, like patchd: it remounts / read-write only to run the vetted,
# reversible carplay_patch.js revert (verified backup, SHA gate), then
# read-only again. Long-running: it records each carplay crash the moment it
# sees it, marks a healthy carplay, and, where recmgr loaded carplay's entry
# this boot, restores at the threshold and runs `systemctl start
# carplay.service` after a crash (bounded per boot). It never stops, kills,
# restarts or reboots anything (PATCH.md "Boot recovery").
ExecStart=/usr/bin/node /var/opt/waze-on-cluster/current/recovery.js
Restart=always
RestartSec=5
# On stop, signal only the daemon (not its mount/revert children) and give an
# in-progress restore time to finish, so / is never left writable.
KillMode=mixed
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
