[Unit]
Description=waze-on-cluster patchd: applies/reverts the reversible carplay patch on the iDrive app's request
RequiresMountsFor=/var/opt
After=local-fs.target

[Service]
# Root, like mgu-updater: the app (unprivileged, in tm_oap_app) asks over the
# socket; this daemon runs the vetted, reversible carplay_patch.js with / briefly
# remounted read-write, then activates the change per PATCH.md "Activation"
# (SIGKILL+start only where recmgr allows it, otherwise at the next head-unit
# start). It applies no patch on its own; on its own it only restarts carplay,
# rate-limited, when the render cannot decode the running stream (PATCH.md
# "Stream resync").
ExecStart=/usr/bin/node /var/opt/waze-on-cluster/current/patchd.js
Restart=always
RestartSec=5
StandardOutput=journal
# On stop, signal only the daemon (not its mount/patch/systemctl children), and
# give an in-progress patch time to finish so / is never left writable.
KillMode=mixed
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
