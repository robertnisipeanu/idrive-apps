[Unit]
Description=waze-on-cluster: the captured CarPlay map, decoded for the cluster renderer
RequiresMountsFor=/var/opt
Requires=waze-on-cluster.socket
# The shared cluster renderer draws the map; its socket starts it at the first
# connection.
Wants=cluster-render.socket
After=local-fs.target waze-on-cluster.socket cluster-render.socket
# The AVB bridge joins BMW's media bus once it is up: ufipc_daemon holds the
# UFIPC channel (IASMediaBus) the bridge opens, avbstreamhandler sets up the
# bus streams, stream 15 among them. Both are Type=forking and fork only
# once that is done, so "after" means ready. Ordering only, never a
# requirement: where either unit is missing or fails, this still starts.
# BMW's boot already orders the two first (both are before early.target,
# systemd-udev-trigger.service after it, sysinit.target and basic.target
# after that); this line keeps it so without relying on that chain. No
# head-unit unit is ordered after this service, so none starts any later.
After=ufipc_daemon.service avbstreamhandler.service

[Service]
# hmi_5000 is in the video group, so this process can open
# /dev/dri/renderD128 for MSDK/VAAPI decode (VERIFIED: /etc/group).
User=hmi_5000
Group=hmi_5000
# The AVB bridge uses the UFIPC shared-memory channel, whose files are
# sin_ufipc:mgu_ufipc mode 0660, which hmi_5000 is not in by default (VERIFIED
# on the car: root could join media_transport.avb_streaming.15, hmi_5000
# could not). tm_oap_app opens the cluster renderer's socket.
SupplementaryGroups=mgu_ufipc tm_oap_app
RuntimeDirectory=waze-on-cluster
# World-traversable so the carplay uid can reach the FIFO (file group-restricted)
# and the diagnostics uid can read status.json; the files set their own modes.
RuntimeDirectoryMode=0755
# The log file's directory (log_file) and the app's choices' (state_file),
# on /var/opt so they outlive reboots, made as root ("+"); a failure ("-")
# only leaves the service without the file, or the choices kept until it
# stops.
ExecStartPre=-+/bin/sh -c 'mkdir -p /var/opt/waze-on-cluster/log /var/opt/waze-on-cluster/state && chown hmi_5000:hmi_5000 /var/opt/waze-on-cluster/log /var/opt/waze-on-cluster/state'
# With Android Auto's turn card hidden, patchd writes the crop that goes
# with its geometry here, a line WOC_SRC_CROP=-s src_crop=<crop>, which
# overrides the conf's. Read at each start.
EnvironmentFile=-/var/opt/waze-on-cluster/aa-crop.env
# With the app's Keep the model badge ticked, patchd writes here a line
# WOC_BADGE=-s tex_size=... -s src_crop=... -s map_rect=..., which draws the
# map 1:1 below the top of the cluster's map area and leaves that strip to
# the car's own model badge (carplay_patch.js SAFE_DEFAULT: y from below the
# native model badge). Before $WOC_SRC_CROP, so Android Auto's crop wins
# where both set one. Read at each start.
EnvironmentFile=-/var/opt/waze-on-cluster/badge.env
ExecStart=/var/opt/waze-on-cluster/current/waze-on-cluster -c /var/opt/waze-on-cluster/current/waze-on-cluster.conf $WOC_BADGE $WOC_SRC_CROP
Restart=on-failure
# At boot RAMSES or DCSM may not be up yet; 5 s keeps the retries clear of
# systemd's start limit (5 starts in 10 s), which would also stop the socket.
RestartSec=5

[Install]
# Runs from boot, so it is listening when the phone's stream starts (its only
# keyframes are at that start) and the map comes up with CarPlay.
WantedBy=multi-user.target
