[Unit]
Description=waze-on-cluster control socket

[Socket]
# The render's status and log for the iDrive app. waze-on-cluster.service runs
# from boot; a connection also starts it if it is not running. systemd creates
# the directory each boot.
ListenStream=/dev/shm/waze-on-cluster/ctl.sock
DirectoryMode=0755
SocketMode=0660
# Every OAP app process has tm_oap_app as a supplementary group, so the iDrive
# app can open the socket.
SocketGroup=tm_oap_app

[Install]
WantedBy=sockets.target
