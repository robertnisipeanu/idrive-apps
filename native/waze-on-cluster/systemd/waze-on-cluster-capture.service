[Unit]
Description=Bounded Waze diagnostic capture and DLT restoration
RequiresMountsFor=/var/opt
After=local-fs.target dlt.service

[Service]
ExecStart=/usr/bin/node /var/opt/waze-on-cluster/current/dlt_capture.js
ExecStopPost=/usr/bin/node /var/opt/waze-on-cluster/current/dlt_capture.js restore
Restart=always
RestartSec=5
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
