[Unit]
Description=cluster-render socket: apps' layers on the cluster and the HUD

[Socket]
# The first client starts cluster-render.service. systemd creates the
# directory each boot.
ListenStream=/dev/shm/cluster-render/render.sock
DirectoryMode=0755
SocketMode=0660
# Every OAP app process has tm_oap_app as a supplementary group.
SocketGroup=tm_oap_app

[Install]
WantedBy=sockets.target
