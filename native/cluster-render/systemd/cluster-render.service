[Unit]
Description=cluster-render: every app's layers on the instrument cluster and the HUD
RequiresMountsFor=/var/opt
Requires=cluster-render.socket
After=local-fs.target cluster-render.socket
# cluster-demo's standalone renderer holds the same RAMSES participant and
# vsomeip identity (README.md "Identity and packaging"); only one of them
# can run.
Conflicts=cluster-demo.service

[Service]
# uid 5000 is the only uid the unit's vsomeip security allows to request
# Dcsm2 and offer the RAMSES distributedrendering services
# (README.md "Identity and packaging"). On iDrive 8 it may offer RAMSES 27's
# RamsesService and RemoteContentManager, as Hmi8 does (README.md
# "iDrive 8"). cluster-render starts the service of the unit's generation.
User=hmi_5000
Group=hmi_5000
RuntimeDirectory=cluster-render
RuntimeDirectoryMode=0755
# The log file's directory (log_file), on /var/opt so it outlives reboots,
# made as root ("+"); a failure ("-") only leaves the service without the
# file.
ExecStartPre=-+/bin/sh -c 'mkdir -p /var/opt/cluster-render/log && chown hmi_5000:hmi_5000 /var/opt/cluster-render/log'
ExecStart=/var/opt/cluster-render/current/cluster-render -c /var/opt/cluster-render/current/cluster-render.conf
Restart=on-failure
# At boot RAMSES or DCSM may not be up yet; 5 s keeps the retries clear of
# systemd's start limit (5 starts in 10 s), which would also stop the socket.
RestartSec=5
